<?xml version="1.0" encoding="utf-8"?>
<com.healthsync.watch.ui.RoundScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/watch_screen_bg" android:fillViewport="true">
    <LinearLayout android:id="@+id/callAlertContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="28dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/watch_card_bg" android:padding="12dp">
        <TextView android:id="@+id/tvCallState" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Incoming phone call" android:textColor="#8CE7C8" android:gravity="center" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvCallerName" style="@style/WatchValue" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Caller" android:gravity="center" android:layout_marginTop="10dp" android:textSize="23sp" />
        <TextView android:id="@+id/tvCallerNumber" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="5dp" />
        </LinearLayout>
        <androidx.cardview.widget.CardView android:id="@+id/btnAnswer" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" android:contentDescription="Answer call on phone"
            android:foreground="?attr/selectableItemBackground" app:cardElevation="0dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#8CE7C8">
            <TextView style="@style/WatchText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="Answer" android:gravity="center" android:textColor="#06110B" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/btnDecline" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:contentDescription="Decline phone call"
            android:foreground="?attr/selectableItemBackground" app:cardElevation="0dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#32131C">
            <TextView style="@style/WatchText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="Decline" android:gravity="center" android:textColor="#FF8395" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        </androidx.cardview.widget.CardView>
        <TextView android:id="@+id/tvCallAudioHint" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="14dp" android:textSize="12sp" android:paddingStart="4dp" android:paddingEnd="4dp" />
    </LinearLayout>
</com.healthsync.watch.ui.RoundScrollView>
