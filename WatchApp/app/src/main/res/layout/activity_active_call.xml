<?xml version="1.0" encoding="utf-8"?>
<!--
  ActiveCall — shown on watch after call is answered
  480×480 round AMOLED · safe-zone: 44dp margins
  Layout: caller name + timer top | 3 action buttons bottom
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030612"
    android:keepScreenOn="true">

    <!-- Phone wave indicator (top) -->
    <TextView
        android:id="@+id/tvCallWave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📞 On Call"
        android:textColor="#30D158"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:paddingTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Caller avatar circle -->
    <TextView
        android:id="@+id/tvCallerAvatar"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:gravity="center"
        android:text="?"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:background="@drawable/circle_button_bg"
        android:backgroundTint="#0A1830"
        app:layout_constraintTop_toBottomOf="@id/tvCallWave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp" />

    <!-- Caller name -->
    <TextView
        android:id="@+id/tvActiveCallerName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="John Doe"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvCallerAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Call duration timer -->
    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="#4A5A80"
        android:textSize="16sp"
        android:fontFamily="sans-serif-thin"
        android:gravity="center"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvActiveCallerName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── 3 action buttons: Mute | Speaker | End ──────────────── -->
    <LinearLayout
        android:id="@+id/btnRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="46dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mute toggle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnMute"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#0A1830"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvMuteIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🎙"
                    android:textSize="22sp" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvMuteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mute"
                android:textColor="#4A5A80"
                android:textSize="10sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <!-- End call — large red circle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginEnd="16dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnEndCall"
                android:layout_width="76dp"
                android:layout_height="76dp"
                app:cardCornerRadius="38dp"
                app:cardBackgroundColor="#FF2D55"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End"
                android:textColor="#FF2D55"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <!-- Speaker toggle -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/btnSpeaker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#0A1830"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/tvSpeakerIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔊"
                    android:textSize="22sp" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvSpeakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="#4A5A80"
                android:textSize="10sp"
                android:layout_marginTop="5dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
