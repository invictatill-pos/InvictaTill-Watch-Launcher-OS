<?xml version="1.0" encoding="utf-8"?>
<com.healthsync.watch.ui.RoundScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#030806">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="28dp" android:paddingBottom="28dp">
        <TextView android:id="@+id/tvCallStatus" style="@style/WatchLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="PHONE CALL ACTIVE" android:textColor="#8CE7C8" android:gravity="center" />
        <TextView android:id="@+id/tvCallerName" style="@style/WatchValue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="Caller" android:textSize="20sp" />
        <TextView android:id="@+id/tvCallTimer" style="@style/WatchValue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:text="00:00" />
        <TextView android:id="@+id/tvAudioRoute" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="6dp" android:text="Checking phone audio…" android:textSize="10sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center" android:layout_marginTop="14dp">
            <androidx.cardview.widget.CardView android:id="@+id/btnMute" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="64dp" android:layout_marginEnd="5dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp" app:cardBackgroundColor="#14231C">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvMuteIcon" style="@style/WatchText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎤" android:textSize="20sp" />
                    <TextView android:id="@+id/tvMuteLabel" style="@style/WatchLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mute" android:layout_marginTop="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/btnSpeaker" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="64dp" android:layout_marginStart="5dp" android:clickable="true" android:focusable="true" app:cardCornerRadius="18dp" app:cardBackgroundColor="#14231C">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvSpeakerIcon" style="@style/WatchText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="20sp" />
                    <TextView android:id="@+id/tvSpeakerLabel" style="@style/WatchLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone" android:layout_marginTop="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <androidx.cardview.widget.CardView android:id="@+id/btnWatchAudio" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:contentDescription="Use watch Bluetooth call audio"
            app:cardCornerRadius="24dp" app:cardBackgroundColor="#14231C">
            <TextView android:id="@+id/tvWatchAudioLabel" style="@style/WatchText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="Use watch audio" android:gravity="center" android:textSize="12sp" android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/btnEndCall" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:clickable="true" android:focusable="true" android:contentDescription="End phone call"
            app:cardCornerRadius="24dp" app:cardBackgroundColor="#AC304A">
            <TextView style="@style/WatchText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="END CALL" android:gravity="center" android:textSize="12sp" android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.healthsync.watch.ui.RoundScrollView>
