<?xml version="1.0" encoding="utf-8"?>
<com.healthsync.watch.ui.RoundScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/watch_screen_bg" android:fillViewport="true">
    <LinearLayout android:id="@+id/inCallContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="28dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center" android:background="@drawable/watch_card_bg" android:padding="12dp">
        <TextView android:id="@+id/tvCallStatus" style="@style/WatchLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="PHONE CALL ACTIVE" android:textColor="#8CE7C8" android:gravity="center" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tvCallerName" style="@style/WatchValue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="Caller" android:textSize="23sp" />
        <TextView android:id="@+id/tvCallTimer" style="@style/WatchValue" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="00:00" android:textSize="30sp" />
        <TextView android:id="@+id/tvAudioRoute" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="6dp" android:text="Checking phone audio…" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center" android:layout_marginTop="14dp">
            <androidx.cardview.widget.CardView android:id="@+id/btnMute" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="72dp" android:layout_marginEnd="5dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardElevation="0dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#11201B">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvMuteIcon" style="@style/WatchText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎤" android:textSize="20sp" />
                    <TextView android:id="@+id/tvMuteLabel" style="@style/WatchLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mute" android:layout_marginTop="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView android:id="@+id/btnSpeaker" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="72dp" android:layout_marginStart="5dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardElevation="0dp" app:cardCornerRadius="22dp" app:cardBackgroundColor="#11201B">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/tvSpeakerIcon" style="@style/WatchText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱" android:textSize="20sp" />
                    <TextView android:id="@+id/tvSpeakerLabel" style="@style/WatchLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phone" android:layout_marginTop="5dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
        <androidx.cardview.widget.CardView android:id="@+id/btnWatchAudio" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:contentDescription="Use watch Bluetooth call audio"
            android:foreground="?attr/selectableItemBackground" app:cardElevation="0dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#11201B">
            <TextView android:id="@+id/tvWatchAudioLabel" style="@style/WatchText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="Use watch audio" android:gravity="center" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView android:id="@+id/btnEndCall" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:contentDescription="End phone call"
            android:foreground="?attr/selectableItemBackground" app:cardElevation="0dp" app:cardCornerRadius="26dp" app:cardBackgroundColor="#AC304A">
            <TextView style="@style/WatchText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="End call" android:gravity="center" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.healthsync.watch.ui.RoundScrollView>
