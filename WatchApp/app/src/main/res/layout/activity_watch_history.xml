<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="#030806" android:paddingTop="24dp">
    <TextView style="@style/WatchText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Workout history" android:gravity="center" android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvHistoryInfo" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Loading sessions…" android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:layout_marginTop="6dp" android:textSize="10sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/historyRecyclerView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:paddingTop="12dp" android:paddingBottom="28dp"
        android:clipToPadding="false" android:scrollbars="none" android:overScrollMode="never" />
    <com.healthsync.watch.ui.RoundScrollView android:id="@+id/historyEmpty" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:gravity="center" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="18dp" android:paddingBottom="28dp">
            <TextView style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Complete a workout to see your progress here." android:gravity="center" />
            <Button android:id="@+id/btnHistoryStart" style="@style/WatchAction" android:layout_width="match_parent"
                android:layout_height="48dp" android:text="START WORKOUT" android:layout_marginTop="16dp" />
        </LinearLayout>
    </com.healthsync.watch.ui.RoundScrollView>
</LinearLayout>
