<?xml version="1.0" encoding="utf-8"?>
<com.healthsync.watch.ui.RoundScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notificationScroll"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#030806" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="28dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/tvAppInitial" style="@style/WatchText" android:layout_width="32dp" android:layout_height="32dp"
                android:text="A" android:gravity="center" android:textColor="#8CE7C8" android:textSize="16sp" android:background="@drawable/bg_app_badge" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/tvAppLabel" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="App" android:textColor="#8CE7C8" android:textStyle="bold" />
                <TextView android:id="@+id/tvNotifTime" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tvNotifTitle" style="@style/WatchText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="14dp" android:textIsSelectable="true" />
        <TextView android:id="@+id/tvConversationTitle" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:layout_marginTop="4dp" android:textColor="#8CE7C8" android:visibility="gone" />
        <TextView android:id="@+id/tvNotifText" style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:layout_marginTop="8dp" android:textIsSelectable="true" />
        <Button android:id="@+id/btnReply" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp" android:text="REPLY" android:layout_marginTop="14dp" />
        <LinearLayout android:id="@+id/replyContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone" android:layout_marginTop="8dp">
            <TextView style="@style/WatchLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quick replies" android:layout_marginBottom="8dp" />
            <Button android:id="@+id/chipOk" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="OK" android:layout_marginBottom="5dp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" />
            <Button android:id="@+id/chipYes" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="Yes" android:layout_marginBottom="5dp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" />
            <Button android:id="@+id/chipNo" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="No" android:layout_marginBottom="5dp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" />
            <Button android:id="@+id/chipOnMyWay" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="On my way!" android:layout_marginBottom="5dp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" />
            <Button android:id="@+id/chipCallLater" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="Call you later" android:layout_marginBottom="5dp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" />
            <Button android:id="@+id/chipThanks" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="Thanks!" android:layout_marginBottom="5dp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" />
            <EditText android:id="@+id/etReplyInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
                android:hint="Type a reply…" android:textColorHint="#9BAEA4" android:textColor="#EEF7F1" android:textSize="13sp"
                android:background="@drawable/watch_input_bg" android:padding="10dp" android:inputType="textShortMessage|textCapSentences|textAutoCorrect"
                android:maxLength="500" android:imeOptions="actionSend" android:layout_marginTop="8dp" />
            <Button android:id="@+id/btnSendCustomReply" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
                android:text="SEND REPLY" android:layout_marginTop="7dp" />
        </LinearLayout>
        <Button android:id="@+id/btnDismiss" style="@style/WatchAction" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="DISMISS ON WATCH" android:textSize="11sp" android:backgroundTint="#14231C" android:textColor="#C8DDD2" android:layout_marginTop="7dp" />
    </LinearLayout>
</com.healthsync.watch.ui.RoundScrollView>
