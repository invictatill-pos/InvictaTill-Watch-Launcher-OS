<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/watchFaceRoot"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">

    <!-- Pre-installed Chrono Ultra Modern Chronograph Watch Face -->
    <com.healthsync.watch.ui.ChronoWatchFaceView
        android:id="@+id/chronoWatchFaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Fallback Ambient Display View -->
    <com.healthsync.watch.ui.CircularWatchFaceView android:id="@+id/circularWatchFaceView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Pre-installed Orbit Watch Face View -->
    <com.healthsync.watch.ui.shell.OrbitWatchFaceView android:id="@+id/orbitWatchFace"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Unified Shell Dock (Apps, Notifications, Settings) -->
    <LinearLayout android:id="@+id/shellDock" android:layout_width="156dp" android:layout_height="44dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="38dp"
        android:orientation="horizontal" android:gravity="center" android:visibility="gone" />

    <!-- Unified Slide-in Panel Host (Fitness, Controls, Notifications, Apps, Settings, Faces) -->
    <FrameLayout android:id="@+id/shellPanelHost" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone" android:importantForAccessibility="yes" />
</FrameLayout>
